// LANTERN STAGING REHEARSAL CONFIGURATION — PREPARED, NOT DEPLOYED
// ---------------------------------------------------------------------------
// Purpose: B7 route/DNS rollback rehearsal on a separate Worker. This file is
// not referenced by any npm script; `npm run deploy` still fails closed.
//
// Isolation rules enforced by tests/environment-configs.test.ts:
//   * Only the staging database and staging media bucket are bound.
//   * No production database/bucket ids, names, or binding names appear here.
//   * No routes, custom domains, or triggers.
//   * workers.dev is enabled deliberately: it gives the rehearsal Worker a
//     safe, separate test URL without touching a production hostname.
//
// Consequences of the isolation rules: public reads are explicitly pinned to
// the staging database and media for anonymous visitors on this Worker. No
// production fallback is attempted; a missing staging binding fails closed.
// Use scripts/rehearsal-smoke-check.mjs for the staged Worker.
//
// Deploying this Worker does not change DNS, routes, or the Flask Worker.
// No deploy has been performed. No approval is granted by this file.
// ---------------------------------------------------------------------------
{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "lantern-nuxt-rehearsal",

  // Safe, separate testing endpoint. No production hostname is involved.
  "workers_dev": true,

  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-11-13",

  // Anonymous account flows must write only to the staging database.
  // Public reads also use staging so anonymous visitors see seeded content.
  // Production writes remain disabled because the production-write flag is absent.
  "vars": {
    "LANTERN_ANONYMOUS_WRITE_DATABASE": "staging",
    "LANTERN_PUBLIC_READ_DATABASE": "staging"
  },

  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public/"
  },

  "d1_databases": [
    {
      "binding": "lantern_staging_db",
      "database_name": "lantern-staging-db",
      "database_id": "5ce6be03-45c1-465e-a461-20e40148404e",
      "remote": true
    }
  ],

  // A1 rehearsal only: forwards production-style /media/* requests to the
  // independent Flask media-origin Worker. The target must be deployed first.
  // This binding does not move traffic and is not present in the release config.
  "services": [
    {
      "binding": "LANTERN_MEDIA_ORIGIN",
      "service": "lantern-media-rehearsal"
    }
  ],

  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,

  "r2_buckets": [
    {
      "binding": "lantern_staging_media",
      "bucket_name": "lantern-staging-media",
      "remote": true
    }
  ]
}
