// LANTERN RELEASE CONFIGURATION — APPROVED A1 PRODUCTION TEMPLATE, NOT DEPLOYED
// ---------------------------------------------------------------------------
// This file is NOT used by `npm run dev`, `npm run build`, `npm run verify`,
// `npm run smoke`, or `npm run release:check`. `npm run deploy` still fails
// closed. Nothing here deploys, binds, or mutates any Cloudflare resource.
//
// Approved A1 shape:
//   * The Nuxt application is deployed under the existing Worker name
//     `lantern`. `workers_dev` stays enabled so the canonical hostname remains
//     https://lantern.midnightcaravans.workers.dev.
//   * The private Flask media Worker `lantern-media` must be prepared and
//     deployed before this Worker. Its config is `wrangler.media-release.jsonc`.
//   * `/media/*` is forwarded to that Worker through `LANTERN_MEDIA_ORIGIN`.
//   * B5 remains approved: Flask is the temporary production media origin.
//
// Production-only scope (2026-11-24):
//   * Staging D1/R2 bindings are intentionally omitted. The verified runtime
//     selects production for anonymous account targets and public reads.
//   * `LANTERN_ENABLE_PRODUCTION_WRITES` is intentionally absent. Production
//     mutations remain blocked until separately approved.
//   * `preview_urls` is false. No Version URL may expose this production-bound
//     Worker before the approved cutover.
//   * No routes, custom domains, or triggers are declared. The workers.dev
//     hostname is inherent to the existing `lantern` Worker name.
//
// All production deployment, secret provisioning, and traffic activation
// require separate explicit authorization. No approval is granted by this file.
// ---------------------------------------------------------------------------
{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "lantern",
  "workers_dev": true,
  "preview_urls": false,

  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-11-13",

  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public/"
  },

  // Explicit production selectors. These do not enable production writes.
  "vars": {
    "LANTERN_ANONYMOUS_WRITE_DATABASE": "production",
    "LANTERN_PUBLIC_READ_DATABASE": "production"
  },

  // A1 media origin. The target Worker must exist before cutover.
  "services": [
    {
      "binding": "LANTERN_MEDIA_ORIGIN",
      "service": "lantern-media"
    }
  ],

  "d1_databases": [
    {
      "binding": "lantern_db",
      "database_name": "lantern-db",
      "database_id": "bf50e1be-81d7-4cd1-b082-8aa03a784860",
      "remote": true
    }
  ],

  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,

  "r2_buckets": [
    {
      // Mirrors the Flask Worker's production R2 binding.
      "bucket_name": "lantern-media",
      "binding": "lantern_media"
    }
  ]
}
