// LANTERN RELEASE CONFIGURATION — PRODUCTION-ONLY TEMPLATE, NOT DEPLOYED
// ---------------------------------------------------------------------------
// This file is NOT used by `npm run dev`, `npm run build`, `npm run verify`,
// `npm run smoke`, or `npm run release:check`. `npm run deploy` still fails
// closed. Nothing here deploys, binds, or mutates any Cloudflare resource.
//
// B1 evidence:
//   * Account: Midnightcaravans@gmail.com's Account (976a3a206836442db1102c6e5d7a0cf5)
//   * `wrangler r2 bucket list` showed the production bucket `lantern-media`.
//   * The pinned Flask Worker config (/Users/christian/lantern/wrangler.jsonc)
//     binds that bucket as `lantern_media`.
//   * Worker name `lantern-nuxt` is proposed and must be approved by the
//     release manager before any deploy.
//
// Production-only scope (2026-11-24):
//   * Staging D1/R2 bindings are intentionally omitted. The verified runtime
//     selects production for anonymous account targets and public reads.
//   * `LANTERN_ENABLE_PRODUCTION_WRITES` is intentionally absent. Production
//     mutations remain blocked until separately approved.
//   * There are no routes, custom domains, or triggers, `workers_dev` is
//     false, and Version URLs are explicitly disabled. Deploying this Worker
//     cannot move production traffic or create a public preview endpoint.
//   * B5 is approved for the first cutover: the Flask Worker remains the
//     temporary production media origin. No media Service Binding is added.
//
// Remaining B1 action: an authorized operator deploys this config to create
// the release Worker with the `lantern_media` binding. That is a production
// change and has NOT been performed. No approval is granted by this file.
// ---------------------------------------------------------------------------
{
  "$schema": "node_modules/wrangler/config-schema.json",

  // PROPOSED — confirm with the release manager. No existing Worker uses this name.
  "name": "lantern-nuxt",
  "workers_dev": false,
  "preview_urls": false,

  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-11-13",

  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public/"
  },

  // Explicit production selectors. These do not enable production writes.
  "vars": {
    "LANTERN_ANONYMOUS_WRITE_DATABASE": "production",
    "LANTERN_PUBLIC_READ_DATABASE": "production"
  },

  "d1_databases": [
    {
      "binding": "lantern_db",
      "database_name": "lantern-db",
      "database_id": "bf50e1be-81d7-4cd1-b082-8aa03a784860",
      "remote": true
    }
  ],

  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,

  "r2_buckets": [
    {
      // Mirrors the Flask Worker's production R2 binding.
      "bucket_name": "lantern-media",
      "binding": "lantern_media"
    }
  ]
}
