// LANTERN RELEASE CONFIGURATION — PREPARED TEMPLATE, NOT DEPLOYED
// ---------------------------------------------------------------------------
// This file is NOT used by `npm run dev`, `npm run build`, `npm run verify`,
// `npm run smoke`, or `npm run release:check`. `npm run deploy` still fails
// closed. Nothing here deploys, binds, or mutates any Cloudflare resource.
//
// B1 preparation (read-only evidence gathered 2026-11-20):
//   * Account: Midnightcaravans@gmail.com's Account (976a3a206836442db1102c6e5d7a0cf5)
//   * `wrangler r2 bucket list` shows the production bucket `lantern-media`.
//   * The pinned Flask Worker config (/Users/christian/lantern/wrangler.jsonc:25-29)
//     binds that bucket as `lantern_media`. The bucket name below is therefore
//     a verified fact, not a guess.
//   * Worker name `lantern-nuxt` was checked and does not yet exist on the
//     account. CONFIRM this name with the release manager before any deploy.
//
// Remaining B1 action: an authorized operator deploys this config to create
// the release Worker with the lantern_media binding. That is a production
// change and has NOT been performed. No approval is granted by this file.
// ---------------------------------------------------------------------------
{
  "$schema": "node_modules/wrangler/config-schema.json",

  // PROPOSED — confirm with release manager. No existing Worker uses this name.
  "name": "lantern-nuxt",

  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-11-13",

  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public/"
  },

  // Keep these in sync with wrangler.jsonc. The Nuxt app reads both bindings;
  // production writes remain blocked in application code.
  "d1_databases": [
    {
      "binding": "lantern_db",
      "database_name": "lantern-db",
      "database_id": "bf50e1be-81d7-4cd1-b082-8aa03a784860",
      "remote": true
    },
    {
      "binding": "lantern_staging_db",
      "database_name": "lantern-staging-db",
      "database_id": "5ce6be03-45c1-465e-a461-20e40148404e",
      "remote": true
    }
  ],

  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,

  "r2_buckets": [
    {
      "bucket_name": "lantern-staging-media",
      "binding": "lantern_staging_media",
      "remote": true
    },
    {
      // B1: the binding the Nuxt media route looks for. Mirrors the Flask
      // Worker's production binding exactly (bucket name + binding only).
      "bucket_name": "lantern-media",
      "binding": "lantern_media"
    }
  ]
}
