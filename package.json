{
  "name": "lantern-nuxt-staging",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "npm run build && wrangler dev",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "parity:routes": "node scripts/parity-coverage.mjs",
    "migrate": "node scripts/migrate.mjs",
    "migrate:plan": "node scripts/migrate.mjs --dry-run",
    "verify": "npm run parity:routes && npm test && npm run build",
    "release:check": "node scripts/release-gate.mjs",
    "deploy": "node scripts/deploy-guard.mjs",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "nuxt": "^4.6.4",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "nitro-cloudflare-dev": "^0.2.2",
    "nitropack": "^2.13.6",
    "vitest": "^3.2.7",
    "wrangler": "^4.162.0"
  }
}
